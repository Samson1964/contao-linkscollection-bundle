<?php
$GLOBALS['TL_CSS'][] = 'bundles/contaolinkscollection/css/style.css';
$GLOBALS['TL_JAVASCRIPT'][] = 'bundles/contaolinkscollection/js/suche.js|static';
?>

<div class="<?= $this->class ?> block"<?= $this->cssID ?><?php if ($this->style): ?> style="<?= $this->style ?>"<?php endif; ?>>

	<?php if($this->menu): ?>
		<div class="menu">
			<ul>
			<?php foreach($this->menu as $m): ?>
				<li><a href="<?= $m['link'] ?>"><?= $m['title'] ?></a></li>
			<?php endforeach; ?>
			</ul>
		</div>
	<?php endif; ?>

	<div id="myFormDiv">
		<form id="myForm" action="<?= $this->sucheUrl ?>" method="get" data-linkscollection-suche="<?= $this->sucheUrl ?>" data-linkscollection-seite="<?= $this->seite ?>">
			<label for="s">Suchbegriff:</label>
			<input autofocus id="s" type="text" name="s" class="form-control" minlength="3" required>
			<input type="hidden" name="seite" value="<?= $this->seite ?>">
			<input type="submit" value="Senden" class="btn btn-primary">
			<span id="ajaxloader"></span>
		</form>
	</div>
	<div id="searchresult"></div>

</div>
