{
    "name": "schachbulle/contao-linkscollection-bundle",
    "type": "contao-bundle",
    "description": "Linksammlung mit beliebig vielen Kategorien und Unterkategorien.",
    "keywords": [
        "contao",
        "links",
        "linksammlung",
        "kategorien"
    ],
    "homepage": "https://github.com/Samson1964/contao-linkscollection-bundle",
    "license": "LGPL-3.0-or-later",
    "authors": [
        {
            "name": "Frank Hoppe",
            "homepage": "https://www.schachbulle.de/"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "contao/core-bundle": "^4.13 || ^5.0",
        "components/flag-icon-css": "^3.5",
        "menatwork/contao-multicolumnwizard-bundle": "^3.6",
        "symfony/config": "^5.4 || ^6.0 || ^7.0",
        "symfony/dependency-injection": "^5.4 || ^6.0 || ^7.0",
        "symfony/http-foundation": "^5.4 || ^6.0 || ^7.0",
        "symfony/http-kernel": "^5.4 || ^6.0 || ^7.0",
        "symfony/routing": "^5.4 || ^6.0 || ^7.0"
    },
    "conflict": {
        "contao/core": "*",
        "contao/manager-plugin": "<2.0 || >=3.0"
    },
    "require-dev": {
        "contao/manager-plugin": "^2.0"
    },
    "extra": {
        "contao-manager-plugin": "Schachbulle\\ContaoLinkscollectionBundle\\ContaoManager\\Plugin"
    },
    "autoload": {
        "psr-4": {
            "Schachbulle\\ContaoLinkscollectionBundle\\": "src/"
        }
    },
    "support": {
        "issues": "https://github.com/Samson1964/contao-linkscollection-bundle/issues",
        "source": "https://github.com/Samson1964/contao-linkscollection-bundle"
    }
}
